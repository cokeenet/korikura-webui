{
  "name": "korikura-webui",
  "version": "0.2.1",
  "description": "Astro + React 的通用 UI 框架：korikura 主题、滚动态导航、毛玻璃、视图过渡与通用组件",
  "type": "module",
  "license": "CC-BY-NC-4.0",
  "author": "Cokee <xiaoyangjunroms@outlook.com>",
  "homepage": "https://github.com/cokeenet/korikura-webui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cokeenet/korikura-webui.git"
  },
  "bugs": {
    "url": "https://github.com/cokeenet/korikura-webui/issues"
  },
  "keywords": [
    "astro",
    "react",
    "tailwindcss",
    "ui",
    "korikura",
    "theme"
  ],
  "exports": {
    "./styles.css": "./src/styles/index.css",
    "./styles/*": "./src/styles/*",
    "./components/*": "./src/components/*",
    "./lib/*": "./src/lib/*",
    "./charts": "./src/charts/index.ts",
    "./charts/*": "./src/charts/*",
    "./datatable": "./src/datatable/DataTable.tsx",
    "./datatable/*": "./src/datatable/*",
    "./forms/*": "./src/forms/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "example:dev": "pnpm --dir examples dev",
    "example:build": "node scripts/check-ui-parity.mjs && pnpm --dir examples build",
    "check": "node scripts/check-ui-parity.mjs",
    "test": "node --test src/charts/*.test.ts"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.0",
    "astro": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@astrojs/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  }
}
